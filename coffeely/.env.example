# Copia este archivo como .env y rellena los valores reales.
# NO commitees el .env con claves reales.

# Google Gemini API Key
# Obtén la tuya en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Google OAuth Client ID
# Obtén el tuyo en: https://console.cloud.google.com → APIs → Credenciales
VITE_GOOGLE_CLIENT_ID=
